{
  "name": "engineering-decision-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun --watch src/server/main.ts --api-only\" \"vite\"",
    "build:web": "vite build",
    "build": "bun scripts/build.ts",
    "start": "bun run build:web && bun src/server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "fonts": "bun scripts/fetch-fonts.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
